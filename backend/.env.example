# Conexión a la base de datos.
# PostgreSQL: postgresql://USUARIO:CONTRASEÑA@localhost:5432/foodstore_db
# Para desarrollo sin instalar nada se puede usar SQLite: sqlite:///./foodstore.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodstore_db

# Firma del JWT: al menos 32 caracteres.
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido en CORS (se pueden poner varios separados por coma).
FRONTEND_ORIGIN=http://localhost:5173
